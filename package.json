{
  "name": "cognate-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "profiles/*",
    "tests/e2e"
  ],
  "scripts": {
    "check": "bun scripts/check-substrate.ts",
    "test": "bun test ./compatibility/phase0/sqlite.test.ts ./tests ./packages ./profiles",
    "verify": "bun run check && bun run test",
    "typecheck": "tsc -p tsconfig.json",
    "example:copilot": "bun examples/copilot/index.ts",
    "example:autonomous-harness": "bun examples/autonomous-harness/index.ts",
    "example:human-approval": "bun examples/human-approval/index.ts",
    "example:generative-ui": "bun examples/generative-ui/index.ts",
    "example:shared-state": "bun examples/shared-state/index.ts",
    "example:artifact-workbench": "bun examples/artifact-workbench/index.ts",
    "example:multi-agent": "bun examples/multi-agent/index.ts",
    "example:cognitive-memory": "bun examples/cognitive-memory/index.ts",
    "example:rvf-branching": "bun examples/rvf-branching/index.ts",
    "example:capability-hot-swap": "bun examples/capability-hot-swap/index.ts",
    "example:domainforge": "bun examples/domainforge/index.ts",
    "example:realitytrace": "bun examples/realitytrace/index.ts",
    "example:ag-ui": "bun examples/ag-ui/index.ts",
    "example:mcp": "bun examples/mcp/index.ts",
    "example:connect": "bun examples/connect/index.ts",
    "test:properties": "bun test ./tests/properties",
    "test:e2e": "cd tests/e2e && bun x playwright test -c playwright.config.ts"
  },
  "devDependencies": {
    "@cognate/a2a": "workspace:*",
    "@cognate/ag-ui": "workspace:*",
    "@cognate/artifacts": "workspace:*",
    "@cognate/capabilities": "workspace:*",
    "@cognate/cli": "workspace:*",
    "@cognate/client": "workspace:*",
    "@cognate/cognitive-api": "workspace:*",
    "@cognate/cognitive-memory": "workspace:*",
    "@cognate/cognitive-ruvector": "workspace:*",
    "@cognate/cognitive-rvf": "workspace:*",
    "@cognate/continuations": "workspace:*",
    "@cognate/domainforge": "workspace:*",
    "@cognate/events": "workspace:*",
    "@cognate/kernel-api": "workspace:*",
    "@cognate/kernel-cordis": "workspace:*",
    "@cognate/mcp": "workspace:*",
    "@cognate/profile": "workspace:*",
    "@cognate/profile-copilot": "workspace:*",
    "@cognate/profile-harness": "workspace:*",
    "@cognate/projections": "workspace:*",
    "@cognate/proto": "workspace:*",
    "@cognate/protocol-connect": "workspace:*",
    "@cognate/protocol-connect-bun": "workspace:*",
    "@cognate/provider-local": "workspace:*",
    "@cognate/provider-openai-compatible": "workspace:*",
    "@cognate/react": "workspace:*",
    "@cognate/realitytrace": "workspace:*",
    "@cognate/runtime-api": "workspace:*",
    "@cognate/runtime-bun": "workspace:*",
    "@cognate/store-memory": "workspace:*",
    "@cognate/store-sqlite": "workspace:*",
    "@cognate/ui-astryx": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
