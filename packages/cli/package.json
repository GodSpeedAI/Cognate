    "@godspeedai/cognate-protocol-connect": "workspace:*",
    "@godspeedai/cognate-protocol-connect-bun": "workspace:*",
    "@godspeedai/cognate-provider-local": "workspace:*",
    "@godspeedai/cognate-react": "workspace:*",
    "@godspeedai/cognate-runtime-api": "workspace:*",
    "@godspeedai/cognate-ui-astryx": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
