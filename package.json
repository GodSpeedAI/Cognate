{
  "name": "cognate-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "profiles/*",
    "tests/e2e",
    "validation/reconstructions/deepseek-harness/cognate",
    "validation/reconstructions/copilot/cognate"
  ],
  "scripts": {
    "check": "bun scripts/check-substrate.ts",
    "test": "bun test ./compatibility/phase0/sqlite.test.ts ./tests ./packages ./profiles",
    "verify": "bun run check && bun run test",
    "typecheck": "tsc -p tsconfig.json",
    "example:copilot": "bun examples/copilot/index.ts",
    "example:autonomous-harness": "bun examples/autonomous-harness/index.ts",
    "example:human-approval": "bun examples/human-approval/index.ts",
    "example:generative-ui": "bun examples/generative-ui/index.ts",
    "example:shared-state": "bun examples/shared-state/index.ts",
    "example:artifact-workbench": "bun examples/artifact-workbench/index.ts",
    "example:multi-agent": "bun examples/multi-agent/index.ts",
    "example:cognitive-memory": "bun examples/cognitive-memory/index.ts",
    "example:rvf-branching": "bun examples/rvf-branching/index.ts",
    "example:capability-hot-swap": "bun examples/capability-hot-swap/index.ts",
    "example:domainforge": "bun examples/domainforge/index.ts",
    "example:realitytrace": "bun examples/realitytrace/index.ts",
    "example:ag-ui": "bun examples/ag-ui/index.ts",
    "example:mcp": "bun examples/mcp/index.ts",
    "example:connect": "bun examples/connect/index.ts",
    "test:properties": "bun test ./tests/properties",
    "test:e2e": "cd tests/e2e && bun x playwright test -c playwright.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@godspeedai/cognate": "workspace:*",
    "@godspeedai/cognate-a2a": "workspace:*",
    "@godspeedai/cognate-ag-ui": "workspace:*",
    "@godspeedai/cognate-artifacts": "workspace:*",
    "@godspeedai/cognate-capabilities": "workspace:*",
    "@godspeedai/cognate-cli": "workspace:*",
    "@godspeedai/cognate-client": "workspace:*",
    "@godspeedai/cognate-cognitive-api": "workspace:*",
    "@godspeedai/cognate-cognitive-memory": "workspace:*",
    "@godspeedai/cognate-cognitive-ruvector": "workspace:*",
    "@godspeedai/cognate-cognitive-rvf": "workspace:*",
    "@godspeedai/cognate-continuations": "workspace:*",
    "@godspeedai/cognate-domainforge": "workspace:*",
    "@godspeedai/cognate-events": "workspace:*",
    "@godspeedai/cognate-execution": "workspace:*",
    "@godspeedai/cognate-execution-ssh": "workspace:*",
    "@godspeedai/cognate-execution-wsl": "workspace:*",
    "@godspeedai/cognate-kernel-api": "workspace:*",
    "@godspeedai/cognate-kernel-cordis": "workspace:*",
    "@godspeedai/cognate-mcp": "workspace:*",
    "@godspeedai/cognate-profile": "workspace:*",
    "@godspeedai/cognate-profile-copilot": "workspace:*",
    "@godspeedai/cognate-profile-harness": "workspace:*",
    "@godspeedai/cognate-projections": "workspace:*",
    "@godspeedai/cognate-proto": "workspace:*",
    "@godspeedai/cognate-protocol-connect": "workspace:*",
    "@godspeedai/cognate-protocol-connect-bun": "workspace:*",
    "@godspeedai/cognate-provider-local": "workspace:*",
    "@godspeedai/cognate-provider-openai-compatible": "workspace:*",
    "@godspeedai/cognate-react": "workspace:*",
    "@godspeedai/cognate-realitytrace": "workspace:*",
    "@godspeedai/cognate-runtime-api": "workspace:*",
    "@godspeedai/cognate-runtime-bun": "workspace:*",
    "@godspeedai/cognate-store-memory": "workspace:*",
    "@godspeedai/cognate-store-sqlite": "workspace:*",
    "@godspeedai/cognate-ui-astryx": "workspace:*",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "diff": "8.0.4",
    "dompurify": "3.4.16",
    "fast-check": "4.10.2",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "mermaid": "11.17.2",
