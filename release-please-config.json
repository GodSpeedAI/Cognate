        "kernel-api",
        "kernel-cordis",
        "mcp",
        "profile",
        "projections",
        "proto",
        "protocol-connect",
        "protocol-connect-bun",
        "provider-local",
        "provider-openai-compatible",
        "react",
        "realitytrace",
        "runtime-api",
        "runtime-bun",
        "store-memory",
        "store-sqlite",
        "ui-astryx",
        "profile-copilot",
