{
  "name": "cognate-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "profiles/*"
  ],
  "scripts": {
    "check": "bun scripts/check-substrate.ts",
    "test": "bun test ./compatibility/phase0/sqlite.test.ts ./tests ./packages ./profiles",
    "verify": "bun run check && bun run test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cognate/a2a": "workspace:*",
    "@cognate/ag-ui": "workspace:*",
    "@cognate/artifacts": "workspace:*",
    "@cognate/capabilities": "workspace:*",
    "@cognate/client": "workspace:*",
    "@cognate/cognitive-api": "workspace:*",
    "@cognate/cognitive-memory": "workspace:*",
    "@cognate/cognitive-ruvector": "workspace:*",
    "@cognate/cognitive-rvf": "workspace:*",
    "@cognate/continuations": "workspace:*",
    "@cognate/domainforge": "workspace:*",
    "@cognate/events": "workspace:*",
    "@cognate/kernel-api": "workspace:*",
    "@cognate/kernel-cordis": "workspace:*",
    "@cognate/mcp": "workspace:*",
    "@cognate/profile": "workspace:*",
    "@cognate/projections": "workspace:*",
    "@cognate/proto": "workspace:*",
    "@cognate/protocol-connect": "workspace:*",
    "@cognate/protocol-connect-bun": "workspace:*",
    "@cognate/provider-local": "workspace:*",
    "@cognate/provider-openai-compatible": "workspace:*",
    "@cognate/react": "workspace:*",
    "@cognate/realitytrace": "workspace:*",
    "@cognate/runtime-api": "workspace:*",
    "@cognate/runtime-bun": "workspace:*",
    "@cognate/store-memory": "workspace:*",
    "@cognate/store-sqlite": "workspace:*",
    "@types/bun": "1.4.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
